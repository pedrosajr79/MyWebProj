# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Multi-IA com fallback automático ────────────────────────────────────────
# Configure os providers que você tem disponível.
# O sistema tentará na ordem abaixo; se um falhar (rate limit/quota) vai para o próximo.

# Anthropic (Claude Haiku — rápido e barato)
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI (GPT-4o mini — econômico)
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Groq (Llama 3 — gratuito com limites generosos, usa SDK OpenAI-compatível)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama3-8b-8192

# Google Gemini (gemini-1.5-flash — gratuito)
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-1.5-flash

# Cohere (Command R — gratuito)
# COHERE_API_KEY=...
# COHERE_MODEL=command-r

# Ordem de preferência dos providers (separados por vírgula)
# Padrão: anthropic,openai,groq,gemini,cohere
# AI_PROVIDER_ORDER=groq,gemini,anthropic,openai,cohere

# Providers desabilitados (separados por vírgula)
# AI_PROVIDERS_DISABLED=cohere

# Stripe (monetização)
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# IDs dos preços Stripe (crie em dashboard.stripe.com > Produtos)
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_BUSINESS_MONTHLY=price_...

# Redes sociais — OAuth (opcional, habilita publicação real)
# Meta (Instagram + Facebook): developers.facebook.com
META_APP_ID=
META_APP_SECRET=
# LinkedIn: linkedin.com/developers
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Twitter/X: developer.twitter.com
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# TikTok: developers.tiktok.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# App
NEXT_PUBLIC_APP_URL=https://carrosseiro.com.br
